{
  "name": "petvoice-lab",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run wasm && cargo test -p petvoice-engine -p petvoice-speech --release && tsx scripts/test.ts",
    "render": "tsx scripts/render.ts",
    "bench": "tsx scripts/bench.ts",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
